<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">

  <Dialog id="createDialog" title="New Travel Request" contentWidth="30rem">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
        <Label text="Employee" required="true"/>
        <ComboBox selectedKey="{create>/EmpId}" items="{/Employee}">
          <core:Item key="{EmpId}" text="{EmpName} ({EmpId})"/>
        </ComboBox>

        <Label text="Destination" required="true"/>
        <ComboBox selectedKey="{create>/DestinationId}" items="{/Destination}">
          <core:Item key="{DestinationId}" text="{DestName} ({DestinationId})"/>
        </ComboBox>

        <Label text="Travel Type"/>
        <Input value="{create>/TravelType}" maxLength="1"/>

        <Label text="Start Date" required="true"/>
        <DatePicker value="{create>/StartDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>

        <Label text="End Date" required="true"/>
        <DatePicker value="{create>/EndDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>

        <Label text="Estimated Cost"/>
        <Input value="{create>/EstimatedCost}" type="Number"/>

        <Label text="Currency"/>
        <Input value="{create>/Currency}" maxLength="5"/>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button text="Create" type="Emphasized" press=".onCreateConfirm"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onCreateCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>