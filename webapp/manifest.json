{
  "_version": "1.60.0",
  "sap.app": {
    "id": "travelrequest",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.22.0",
      "toolsId": "0e378d20-5ce5-44ea-9e3d-0d06ce4921e9"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zic_travel_req_sb/srvd/sap/zic_travel_req_sd/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "dependencies": {
      "minUI5Version": "1.120.34",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
         "sap.f": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "travelrequest.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        }
      },
   
  
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TravelRequestList",
          "target": [
            "TravelRequestList"
          ]
        },
        {
          "pattern": "TravelRequest({key}):?query:",
          "name": "TravelRequestObjectPage",
          "target": [
            "TravelRequestList",
            "TravelRequestObjectPage"
          ]
        }
      ],
      "targets": {
        "TravelRequestList": {
          "type": "Component",
          "id": "TravelRequestList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "contextPattern": "",
          "options": {
            "settings": {
              "contextPath": "/TravelRequest",
              "variantManagement": "Page",
              "navigation": {
                "TravelRequest": {
                  "detail": {
                    "route": "TravelRequestObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "QuickCreate": {
                     "press": "travelrequest.ext.controller.ListReportExt.openCreate",
                      "visible": true,
                      "enabled": true,
                      "text": "Create Request",
                      "requiresSelection": false
                    },
                    
  "SubmitDialog": {
    "press": "travelrequest.ext.controller.ListReportExt.submitSelected",
    "visible": true,
    "enabled": true,
    "text": "Submit",
    "requiresSelection": true
  }
                  }
                }
              }
            }
          }
        },
        "TravelRequestObjectPage": {
          "type": "Component",
          "id": "TravelRequestObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "contextPattern": "/TravelRequest({key})",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/TravelRequest"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}